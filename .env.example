# ---------- Mode local (sans Supabase) ----------
# Secret de signature des sessions : OBLIGATOIRE en production (32 caractères minimum).
# Générer : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Compte de démo créé par `npm run dev` (développement uniquement)
# DEMO_USERNAME=demo
# DEMO_PASSWORD=pokemon-demo

# Dossier des données en mode local (défaut : ./.data)
# HOLOFOIL_DATA_DIR=

# ---------- Mode Supabase (auth + Postgres) ----------
# Si ces 3 variables sont présentes, l'app utilise Supabase (comptes + base de données) : c'est le mode à utiliser en ligne.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé service_role : SERVEUR UNIQUEMENT (jamais préfixée NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=

# Domaine des e-mails techniques derrière les pseudos (jamais affichés, aucun e-mail envoyé).
# À changer seulement si Supabase refuse le domaine par défaut (ex. : example.com).
# PSEUDO_EMAIL_DOMAIN=joueurs.holofoil.invalid
